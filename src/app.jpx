    restingHr: 51,
    workoutDone: true,
    workoutType: 'Easy Short Run'
  });

  // Calculate 7-Day HRV Average
  const current7dHrvAvg = Math.round(
    history.slice(-7).reduce((acc, curr) => acc + Number(curr.hrv), 0) / Math.min(history.length, 7)
  );

